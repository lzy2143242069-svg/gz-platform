let currentWordGroup = 'core';
let currentWordIndex = 0;
let currentWordList = [];

function shuffleArray(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
}

function setWordGroup(group) {
    currentWordGroup = group;
    currentWordList = shuffleArray(WORD_GROUPS[group]);
    currentWordIndex = 0;
    document.querySelectorAll('.fc-ctrl-btn').forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    renderWord();
}

function renderWord() {
    const words = currentWordList.length ? currentWordList : WORD_GROUPS[currentWordGroup];
    const w = words[currentWordIndex];
    document.getElementById('fcWord').textContent = w.word;
    document.getElementById('fcPhonetic').textContent = w.phonetic;
    document.getElementById('fcMeaning').textContent = w.meaning;
    document.getElementById('fcExample').textContent = w.example;
    document.getElementById('flashcard').classList.remove('flipped');
    document.getElementById('fcProgressFill').style.width = ((currentWordIndex + 1) / words.length * 100) + '%';
    document.getElementById('fcProgressText').textContent = (currentWordIndex + 1) + ' / ' + words.length;
}

function nextWord() {
    const words = currentWordList.length ? currentWordList : WORD_GROUPS[currentWordGroup];
    currentWordIndex = (currentWordIndex + 1) % words.length;
    renderWord();
}

function prevWord() {
    const words = currentWordList.length ? currentWordList : WORD_GROUPS[currentWordGroup];
    currentWordIndex = (currentWordIndex - 1 + words.length) % words.length;
    renderWord();
}

// ========== 估分系统 ==========
function calcScore() {
    const eng = parseInt(document.getElementById('scoreEnglish').value) || 0;
    const major = parseInt(document.getElementById('scoreMajor').value) || 0;
    const prof = parseInt(document.getElementById('scoreProf').value) || 0;
    const culture = eng + major;  // 文化课总分 300
    const total = culture + prof; // 总分 450
    if (total === 0) { document.getElementById('scoreResult').style.display = 'none'; return; }
    document.getElementById('scoreResult').style.display = 'block';
    document.getElementById('scoreTotalNum').textContent = total;
    document.getElementById('scoreCultureNum').textContent = culture;

    const color = total >= 350 ? 'var(--green)' : total >= 280 ? 'var(--orange)' : 'var(--red)';
    document.getElementById('scoreTotalNum').style.color = color;

    // 对比省控线（文化课满分300）
    const lines = [
        { id:'Wenshi', line:99 }, { id:'Ligong', line:49 }, { id:'YishuW', line:70 },
        { id:'YishuL', line:37 }, { id:'TyuW', line:70 }, { id:'TyuL', line:36 }
    ];
    lines.forEach(l => {
        const pct = Math.min(100, (culture / 300) * 100);
        document.getElementById('bar' + l.id).style.width = pct + '%';
    });

    // 学校难度分档（贵州大学不参与专升本，按往年录取热度排序）
    const hard = ['贵州师范大学','贵州财经大学','贵州医科大学','遵义医科大学','贵州中医药大学','贵州民族大学'];
    const mid  = ['贵州师范学院','遵义师范学院','贵州理工学院','铜仁学院','凯里学院','安顺学院','贵州工程应用技术学院','黔南民族师范学院','兴义民族师范学院','六盘水师范学院','贵阳学院','贵州商学院','贵州警察学院','贵阳康养职业大学','贵州交通职业大学'];
    const easy = ['茅台学院','贵阳信息科技学院','贵州黔南科技学院','贵阳人文科技学院','遵义医科大学医学与科技学院','贵州中医药大学时珍学院','贵州医科大学神奇民族医药学院','贵州黔南经济学院'];

    // 根据总分动态分配三档
    let sprint = [], stable = [], safe = [];
    const passLine = culture >= 49; // 文化课过最低省控线

    if (!passLine) {
        // 未过省控线
        sprint = []; stable = []; safe = [];
    } else if (total >= 380) {
        // 高分：冲全部、稳大部分、保易校
        sprint = hard;
        stable = mid;
        safe = easy;
    } else if (total >= 330) {
        // 中高分：冲前3难校、稳中等校、保易校
        sprint = hard.slice(0, 3);
        stable = hard.slice(3).concat(mid.slice(0, 6));
        safe = mid.slice(6).concat(easy);
    } else if (total >= 280) {
        // 中等分：冲1-2难校、稳部分中校、保易校
        sprint = hard.slice(0, 1);
        stable = mid.slice(0, 5);
        safe = mid.slice(5).concat(easy);
    } else if (total >= 200) {
        // 低分：无冲刺、稳难校、保中+易校
        sprint = [];
        stable = mid.slice(0, 3);
        safe = mid.slice(3).concat(easy);
    } else {
        // 极低分
        sprint = [];
        stable = [];
        safe = easy;
    }

    let html = '';
    if (sprint.length) {
        html += '<div style="margin-bottom:16px"><div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><span style="font-size:20px">🔥</span><span style="font-size:14px;font-weight:600;color:var(--red)">冲（冲刺）</span><span style="font-size:12px;color:var(--text-muted)">竞争激烈，有机会但不保证</span></div><div>' + sprint.map(s => '<span class="score-school-tag score-school-risk">' + s + '</span>').join('') + '</div></div>';
    }
    if (stable.length) {
        html += '<div style="margin-bottom:16px"><div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><span style="font-size:20px">🎯</span><span style="font-size:14px;font-weight:600;color:var(--orange)">稳（稳妥）</span><span style="font-size:12px;color:var(--text-muted)">把握较大，正常发挥即可</span></div><div>' + stable.map(s => '<span class="score-school-tag score-school-mid">' + s + '</span>').join('') + '</div></div>';
    }
    if (safe.length) {
        html += '<div style="margin-bottom:16px"><div style="display:flex;align-items:center;gap:8px;margin-bottom:8px"><span style="font-size:20px">✅</span><span style="font-size:14px;font-weight:600;color:var(--green)">保（保底）</span><span style="font-size:12px;color:var(--text-muted)">基本确定能录取</span></div><div>' + safe.map(s => '<span class="score-school-tag score-school-safe">' + s + '</span>').join('') + '</div></div>';
    }
    if (!html) {
        html = '<div style="text-align:center;padding:20px"><p style="color:var(--red);font-size:14px;font-weight:600">文化课未过省控线，暂无可报考院校</p><p style="color:var(--text-muted);font-size:12px;margin-top:6px">继续努力，距离考试还有时间！</p></div>';
    }
    html += '<p style="font-size:11px;color:var(--text-muted);margin-top:12px">* 分档基于学校综合实力和往年录取难度估算，实际录取分数线每年波动，仅供参考</p>';
    document.getElementById('schoolSuggestion').innerHTML = html;
}

// ========== 主初始化 ==========
async function init() {
    updateCountdowns();
    setInterval(updateCountdowns, 1000);
    initDailyQuote();
    try {
        const [overview, mapData, unis] = await Promise.all([
            fetchJSON('/api/stats/overview'),
            fetchJSON('/api/university/map-data'),
            fetchJSON('/api/university/list?page=1&size=100')
        ]);
        document.getElementById('sTotal').textContent = overview.totalUniversities;
        document.getElementById('sBenke').textContent = overview.benkeCount;
        document.getElementById('sZhuanke').textContent = overview.zhuankeCount;
        document.getElementById('sZsb').textContent = overview.zsbUniversities;

        // 关键修复：按 rankSoft 排序，本科在前专科在后
        allMapData = mapData;
        allUniversities = (unis.records || []).sort((a, b) => {
            const ab = a.type === '本科', bb = b.type === '本科';
            if (ab && !bb) return -1;
            if (!ab && bb) return 1;
            if (ab && bb) return (a.rankSoft || 999) - (b.rankSoft || 999);
            return a.id - b.id;
        });

        // 填充城市下拉
        const cities = [...new Set(allUniversities.map(u => u.city))].sort();
        [document.getElementById('cityFilter'), document.getElementById('mapCityFilter')].forEach(sel => {
            cities.forEach(c => { const o = document.createElement('option'); o.value = c; o.textContent = c; sel.appendChild(o); });
        });

        initHomeCharts(mapData, overview);
        initMap(mapData);
        initZsbTab();
        renderTable();
        initLandmarks();
    } catch (e) { console.error('初始化失败:', e); }
}

// ========== 首页图表 ==========
function initHomeCharts(mapData, overview) {
    const cityCount = {};
    mapData.forEach(u => { cityCount[u.city] = (cityCount[u.city] || 0) + 1; });
    const sorted = Object.entries(cityCount).sort((a, b) => b[1] - a[1]);
    echarts.init(document.getElementById('homeBarChart')).setOption({
        tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
        grid: { left: 50, right: 20, top: 20, bottom: 40 },
        xAxis: { type: 'category', data: sorted.map(s => s[0]), axisLabel: { color: '#94a3b8', rotate: 30, fontSize: 11 }, axisLine: { lineStyle: { color: '#1e293b' } } },
        yAxis: { type: 'value', axisLabel: { color: '#64748b' }, splitLine: { lineStyle: { color: '#1e293b' } } },
        series: [{ type: 'bar', data: sorted.map(s => s[1]), barWidth: '50%', itemStyle: { color: new echarts.graphic.LinearGradient(0,0,0,1,[{offset:0,color:'#3b82f6'},{offset:1,color:'#1d4ed8'}]), borderRadius: [4,4,0,0] } }]
    });
    const nc = { '公办本科': 0, '民办本科': 0, '公办专科': 0, '民办专科': 0 };
    allUniversities.forEach(u => { const k = (u.nature === '公办' ? '公办' : '民办') + u.type; nc[k] = (nc[k] || 0) + 1; });
    echarts.init(document.getElementById('homePieChart')).setOption({
        tooltip: { trigger: 'item' },
        legend: { bottom: 0, textStyle: { color: '#94a3b8', fontSize: 11 } },
        series: [{ type: 'pie', radius: ['35%', '60%'], label: { color: '#94a3b8', formatter: '{b}\n{c}所', fontSize: 11 },
            data: [
                { value: nc['公办本科'], name: '公办本科', itemStyle: { color: '#3b82f6' } },
                { value: nc['民办本科'], name: '民办本科', itemStyle: { color: '#60a5fa' } },
                { value: nc['公办专科'], name: '公办专科', itemStyle: { color: '#f59e0b' } },
                { value: nc['民办专科'], name: '民办专科', itemStyle: { color: '#fbbf24' } }
            ]
        }]
    });
}

// ========== 地图 ==========
function initMap(mapData) {
    fetch('https://geo.datav.aliyun.com/areas_v3/bound/520000_full.json').then(r => r.json()).then(geoJson => {
        echarts.registerMap('guizhou', geoJson);
        mapChart = echarts.init(document.getElementById('mapChart'));
        renderMap(mapData, 'all', 'all');
    });
}

function buildMapPoints(mapData) {
    const cityGroups = {};
    mapData.forEach(u => { const k = u.city || 'x'; if (!cityGroups[k]) cityGroups[k] = []; cityGroups[k].push(u); });
    const uniPoints = [];
    Object.values(cityGroups).forEach(group => {
        const n = group.length;
        group.forEach((u, i) => {
            let lng = u.lng, lat = u.lat;
            if (n > 1) { const a = (2*Math.PI*i)/n + (i%2? -0.15 : 0.2); const r = 0.035*(1+(i%3)*0.35); lng += r*Math.cos(a); lat += r*Math.sin(a); }
            uniPoints.push({ name: u.name, value: [lng, lat, 1], city: u.city, itemStyle: { color: u.isZsbTarget ? '#f59e0b' : '#3b82f6' } });
        });
    });
    return {
        uniPoints,
        trainPoints: TRAIN_STATIONS.map(s => ({ name: s.name, value: [s.lng, s.lat, 1], city: s.city, itemStyle: { color: '#10b981' } })),
        mallPoints: MALL_AREAS.map(m => ({ name: m.name, value: [m.lng, m.lat, 1], city: m.city, radius: m.radius, itemStyle: { color: '#ef4444' } }))
    };
}

function renderMap(mapData, layer, city) {
    if (!mapChart) return;
    const { uniPoints, trainPoints, mallPoints } = buildMapPoints(mapData);
    let fu = uniPoints, ft = trainPoints, fm = mallPoints;
    if (city !== 'all') { fu = fu.filter(p => p.city === city); ft = ft.filter(p => p.city === city); fm = fm.filter(p => p.city === city); }
    const show = l => layer === 'all' || layer === l;
    const series = [];
    if (show('uni')) {
        series.push({ name: '高校', type: 'scatter', coordinateSystem: 'geo', data: fu.filter(p => p.itemStyle.color !== '#f59e0b'), symbolSize: 11, z: 3, label: { show: false }, emphasis: { label: { show: true, formatter: '{b}', fontSize: 11, color: '#fff', backgroundColor: 'rgba(0,0,0,0.7)', padding: [4,8], borderRadius: 4 } } });
        series.push({ name: '可专升本高校', type: 'scatter', coordinateSystem: 'geo', data: fu.filter(p => p.itemStyle.color === '#f59e0b'), symbolSize: 13, z: 3, label: { show: false }, emphasis: { label: { show: true, formatter: '{b}', fontSize: 11, color: '#f59e0b', backgroundColor: 'rgba(0,0,0,0.7)', padding: [4,8], borderRadius: 4 } } });
    }
    if (show('train')) series.push({ name: '高铁站', type: 'scatter', coordinateSystem: 'geo', data: ft, symbol: 'diamond', symbolSize: 14, z: 3, label: { show: false }, emphasis: { label: { show: true, formatter: '{b}', fontSize: 11, color: '#10b981', backgroundColor: 'rgba(0,0,0,0.7)', padding: [4,8], borderRadius: 4 } } });
    if (show('mall')) {
        // 商圈：小圆形 + 半透明渐变感
        var mallData = fm.map(function(m) {
            return { name: m.name, value: [m.value[0], m.value[1], 1], city: m.city, r: m.radius || 0.25 };
        });
        series.push({
            name: '繁华商圈', type: 'scatter', coordinateSystem: 'geo',
            data: mallData,
            symbolSize: function(val, params) { return Math.round((params.data.r / 0.25) * 22); },
            z: 2, symbol: 'circle',
            itemStyle: { color: 'rgba(239,68,68,0.25)', borderColor: 'rgba(239,68,68,0.6)', borderWidth: 1.5 },
            label: { show: false },
            emphasis: { itemStyle: { color: 'rgba(239,68,68,0.45)', borderColor: '#ef4444', borderWidth: 2 } }
        });
        // 外层光晕
        series.push({
            name: '商圈热力', type: 'scatter', coordinateSystem: 'geo',
            data: mallData,
            symbolSize: function(val, params) { return Math.round((params.data.r / 0.25) * 44); },
            z: 1, symbol: 'circle',
            itemStyle: { color: 'rgba(239,68,68,0.08)', borderColor: 'transparent', borderWidth: 0 },
            label: { show: false },
            silent: true,
            tooltip: { show: false }
        });
    }
    mapChart.setOption({
        tooltip: { trigger: 'item', backgroundColor: 'rgba(15,23,42,0.95)', borderColor: 'rgba(255,255,255,0.1)', textStyle: { color: '#f0f4f8', fontSize: 13 },
            formatter: p => { if (!p.name) return ''; let h = '<b>' + p.name + '</b>'; if (p.seriesName === '可专升本高校') h += ' <span style="color:#f59e0b">可专升本</span>'; if (p.seriesName === '高铁站') h += ' 🚄'; if (p.seriesName === '繁华商圈') h += ' 🏙️'; return h; }
        },
        legend: { data: ['高校','可专升本高校','高铁站','繁华商圈','商圈热力'], bottom: 10, textStyle: { color: '#94a3b8', fontSize: 11 } },
        geo: { map: 'guizhou', roam: true, zoom: 1.15, itemStyle: { areaColor: '#1a2538', borderColor: '#2d3f5a', borderWidth: 1 }, emphasis: { itemStyle: { areaColor: '#243352' } }, label: { show: false } },
        series: series
    }, true);
}

function setMapLayer(layer, btn) {
    currentMapLayer = layer;
    document.querySelectorAll('[data-layer]').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    renderMap(allMapData, layer, document.getElementById('mapCityFilter').value);
}
function filterMapByCity(city) { renderMap(allMapData, currentMapLayer, city); }

// ========== 专升本 ==========
let allPlans = [];
let planFiltered = [];
let planPage = 1;
const PLAN_PAGE_SIZE = 20;

async function initZsbTab() {
    currentWordList = shuffleArray(WORD_GROUPS[currentWordGroup]);
    renderWord();
    const zsb = allUniversities.filter(u => u.isZsbTarget);
    document.getElementById('zsbTbody').innerHTML = zsb.map(u => `<tr><td>${u.rankSoft ? '<span class="rank-badge '+(u.rankSoft<=3?'rank-'+u.rankSoft:'rank-n')+'">'+u.rankSoft+'</span>' : '-'}</td><td class="uni-name">${u.name}</td><td><span class="tag tag-benke">${u.type}</span></td><td><span class="tag ${u.nature==='公办'?'tag-public':'tag-private'}">${u.nature}</span></td><td>${u.city}</td><td>${u.level||'-'}</td></tr>`).join('');

    // Load 2026 plans
    try {
        const resp = await fetch(API + '/api/zsb/plans?year=2026&page=1&size=800');
        const json = await resp.json();
        const pageData = json.data || {};
        allPlans = pageData.records || [];

        // Update info cards
        const totalPlans = allPlans.reduce((s, p) => s + (p.planCount || 0), 0);
        const uniqueMajors = new Set(allPlans.map(p => p.majorName)).size;
        document.getElementById('zsbPlanTotal').textContent = totalPlans;
        document.getElementById('zsbMajorTotal').textContent = uniqueMajors;
        document.getElementById('planCountLabel').textContent = allPlans.length + ' 条记录';

        // Build filter dropdowns
        const uniMap = {};
        allUniversities.forEach(u => { uniMap[u.id] = u.name; });
        const uniIds = [...new Set(allPlans.map(p => p.universityId))].sort((a,b) => a-b);
        const uniFilter = document.getElementById('planUniFilter');
        uniIds.forEach(uid => {
            const opt = document.createElement('option');
            opt.value = uid;
            opt.textContent = uniMap[uid] || ('ID:' + uid);
            uniFilter.appendChild(opt);
        });
        const cats = [...new Set(allPlans.map(p => p.category).filter(Boolean))].sort();
        const catFilter = document.getElementById('planCatFilter');
        cats.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c;
            opt.textContent = c;
            catFilter.appendChild(opt);
        });

        planFiltered = [...allPlans];
        renderPlanTable();
    } catch (e) {
        console.warn('加载招生计划失败:', e);
        document.getElementById('planTbody').innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:32px;">暂无招生计划数据</td></tr>';
    }

    const tc = echarts.init(document.getElementById('zsbTrendChart'));
    fetchJSON('/api/zsb/score-trend?universityId=2&majorName=数据科学与大数据技术').then(data => {
        if (!data || !data.length) { tc.setOption({ title: { text: '专升本历年分数线数据正在采集中', left: 'center', top: 'center', textStyle: { color: '#64748b', fontSize: 14, fontWeight: 'normal' } } }); return; }
        tc.setOption({ tooltip: { trigger: 'axis' }, legend: { data: ['分数线','最高分'], bottom: 0, textStyle: { color: '#94a3b8' } }, grid: { left: 50, right: 30, top: 30, bottom: 40 }, xAxis: { type: 'category', data: data.map(d => d.year+'年'), axisLabel: { color: '#94a3b8' }, axisLine: { lineStyle: { color: '#1e293b' } } }, yAxis: { type: 'value', axisLabel: { color: '#64748b' }, splitLine: { lineStyle: { color: '#1e293b' } } }, series: [{ name: '分数线', type: 'line', data: data.map(d => d.totalScore), smooth: true, lineStyle: { width: 3 }, itemStyle: { color: '#f59e0b' }, areaStyle: { color: new echarts.graphic.LinearGradient(0,0,0,1,[{offset:0,color:'rgba(245,158,11,0.3)'},{offset:1,color:'rgba(245,158,11,0)'}]) } }, { name: '最高分', type: 'line', data: data.map(d => d.maxScore), smooth: true, lineStyle: { width: 2, type: 'dashed' }, itemStyle: { color: '#3b82f6' } }] });
    }).catch(() => { tc.setOption({ title: { text: '专升本历年分数线数据正在采集中', left: 'center', top: 'center', textStyle: { color: '#64748b', fontSize: 14, fontWeight: 'normal' } } }); });

    // 招生计划分布图表
    if (allPlans && allPlans.length > 0) {
        const uniMap = {};
        allUniversities.forEach(u => { uniMap[u.id] = u.name; });

        // ========== 各校招生计划数 Top10 ==========
        const uniPlanMap = {};
        allPlans.forEach(p => {
            const name = uniMap[p.universityId] || ('ID:' + p.universityId);
            uniPlanMap[name] = (uniPlanMap[name] || 0) + (p.planCount || 0);
        });
        const uniTop = Object.entries(uniPlanMap).sort((a, b) => b[1] - a[1]).slice(0, 10);
        const uniChart = echarts.init(document.getElementById('planByUniChart'));
        uniChart.setOption({
            tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
            grid: { left: 60, right: 30, top: 40, bottom: 100 },
            xAxis: {
                type: 'category',
                data: uniTop.map(d => d[0]),
                axisLabel: { color: '#94a3b8', fontSize: 12, rotate: 45, interval: 0 },
                axisTick: { show: false },
                axisLine: { lineStyle: { color: '#1e293b' } }
            },
            yAxis: { type: 'value', show: false },
            series: [{
                type: 'bar',
                data: uniTop.map((d, i) => ({
                    value: d[1],
                    itemStyle: { color: ['#8b5cf6','#7c3aed','#6d28d9','#5b21b6','#4c1d95','#3b82f6','#2563eb','#1d4ed8','#1e40af','#1e3a8a'][i] }
                })),
                barWidth: '25%',
                barCategoryGap: '60%',
                label: { show: true, position: 'top', color: '#e2e8f0', fontSize: 14, fontWeight: 'bold' },
                itemStyle: { borderRadius: [8, 8, 0, 0] }
            }]
        });

        // ========== 热门招生专业 Top10 ==========
        const majorPlanMap = {};
        allPlans.forEach(p => {
            majorPlanMap[p.majorName] = (majorPlanMap[p.majorName] || 0) + (p.planCount || 0);
        });
        const majorTop = Object.entries(majorPlanMap).sort((a, b) => b[1] - a[1]).slice(0, 10);
        const majorChart = echarts.init(document.getElementById('planByMajorChart'));
        majorChart.setOption({
            tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
            grid: { left: 60, right: 30, top: 40, bottom: 100 },
            xAxis: {
                type: 'category',
                data: majorTop.map(d => d[0]),
                axisLabel: { color: '#94a3b8', fontSize: 12, rotate: 45, interval: 0 },
                axisTick: { show: false },
                axisLine: { lineStyle: { color: '#1e293b' } }
            },
            yAxis: { type: 'value', show: false },
            series: [{
                type: 'bar',
                data: majorTop.map((d, i) => ({
                    value: d[1],
                    itemStyle: { color: ['#ef4444','#dc2626','#b91c1c','#f97316','#ea580c','#f59e0b','#d97706','#eab308','#84cc16','#22c55e'][i] }
                })),
                barWidth: '25%',
                barCategoryGap: '60%',
                label: { show: true, position: 'top', color: '#e2e8f0', fontSize: 14, fontWeight: 'bold' },
                itemStyle: { borderRadius: [8, 8, 0, 0] }
            }]
        });

        window.addEventListener('resize', () => { uniChart.resize(); majorChart.resize(); });
    }
}

function filterPlans() {
    const s = document.getElementById('planSearch').value.trim().toLowerCase();
    const uniId = document.getElementById('planUniFilter').value;
    const cat = document.getElementById('planCatFilter').value;
    planFiltered = allPlans.filter(p => {
        if (s && !p.majorName.toLowerCase().includes(s)) return false;
        if (uniId !== 'all' && String(p.universityId) !== uniId) return false;
        if (cat !== 'all' && p.category !== cat) return false;
        return true;
    });
    planPage = 1;
    renderPlanTable();
}

function renderPlanTable() {
    const uniMap = {};
    allUniversities.forEach(u => { uniMap[u.id] = u.name; });
    const totalPages = Math.ceil(planFiltered.length / PLAN_PAGE_SIZE);
    if (planPage > totalPages) planPage = totalPages || 1;
    const start = (planPage - 1) * PLAN_PAGE_SIZE;
    const page = planFiltered.slice(start, start + PLAN_PAGE_SIZE);

    document.getElementById('planTbody').innerHTML = page.map(p =>
        `<tr><td class="uni-name">${uniMap[p.universityId]||('ID:'+p.universityId)}</td><td>${p.majorName}</td><td>${p.category||'-'}</td><td><strong>${p.planCount||'-'}</strong></td><td>${p.tuition ? p.tuition.toLocaleString() : '-'}</td><td>${p.duration||'-'}</td><td style="color:var(--text-muted);font-size:13px;">${p.campus||'本校'}</td></tr>`
    ).join('');

    document.getElementById('planInfo').textContent = `共 ${planFiltered.length} 条，第 ${planPage}/${totalPages||1} 页`;
    let pg = '';
    if (totalPages > 1) {
        if (planPage > 1) pg += `<button onclick="goPlanPage(${planPage-1})">‹</button>`;
        for (let i = 1; i <= totalPages; i++) {
            if (totalPages > 7 && i > 3 && i < totalPages - 1 && Math.abs(i - planPage) > 1) {
                if (i === 4 || i === totalPages - 2) pg += '<span style="padding:0 6px;color:var(--text-muted)">...</span>';
                continue;
            }
            pg += `<button class="${i===planPage?'active':''}" onclick="goPlanPage(${i})">${i}</button>`;
        }
        if (planPage < totalPages) pg += `<button onclick="goPlanPage(${planPage+1})">›</button>`;
    }
    document.getElementById('planPagination').innerHTML = pg;
}
function goPlanPage(n) { planPage = n; renderPlanTable(); }

// ========== 高校对比 ==========
const compareIds = new Set();
function toggleCompare(id) {
    if (compareIds.has(id)) { compareIds.delete(id); }
    else if (compareIds.size >= 4) { return; }
    else { compareIds.add(id); }
    updateCompareBar();
    syncCheckboxes();
}
function updateCompareBar() {
    const bar = document.getElementById('compareBar');
    const names = document.getElementById('cbNames');
    const btn = document.getElementById('cbCompareBtn');
    document.getElementById('cbCount').textContent = compareIds.size;
    names.innerHTML = [...compareIds].map(id => {
        const u = allUniversities.find(x => x.id === id);
        return u ? '<span class="cb-name">' + u.name + ' <span class="cb-rm" onclick="toggleCompare(' + id + ')">×</span></span>' : '';
    }).join('');
    btn.disabled = compareIds.size < 2;
    bar.classList.toggle('show', compareIds.size > 0);
}
function syncCheckboxes() {
    document.querySelectorAll('.uni-cb').forEach(cb => { cb.checked = compareIds.has(Number(cb.dataset.id)); });
    const all = document.querySelectorAll('.uni-cb');
    const checked = document.querySelectorAll('.uni-cb:checked');
    document.getElementById('checkAll').checked = all.length > 0 && all.length === checked.length;
}
function toggleCheckAll(el) {
    const page = getFiltered().slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
    if (el.checked) { page.forEach(u => { if (compareIds.size < 4 || compareIds.has(u.id)) compareIds.add(u.id); }); }
    else { page.forEach(u => compareIds.delete(u.id)); }
    updateCompareBar();
    syncCheckboxes();
}
function clearCompare() { compareIds.clear(); updateCompareBar(); syncCheckboxes(); }

function openCompareModal() {
    const ids = [...compareIds];
    const unis = ids.map(id => allUniversities.find(u => u.id === id)).filter(Boolean);
    if (unis.length < 2) return;
    const cols = unis.length;
    const fields = [
        { label: '排名', fn: u => u.rankSoft ? '#' + u.rankSoft : '-', best: 'min' },
        { label: '类型', fn: u => u.type },
        { label: '性质', fn: u => u.nature },
        { label: '城市', fn: u => u.city },
        { label: '层次', fn: u => u.level || '-' },
        { label: '可专升本', fn: u => u.isZsbTarget ? '✅ 是' : '否' },
    ];
    const gridCols = '160px ' + '1fr '.repeat(cols);
    let html = '<div class="modal-head"><h2>高校对比（' + cols + '所）</h2><button class="modal-close" onclick="closeModal()">×</button></div><div class="modal-body"><div class="compare-grid" style="grid-template-columns:' + gridCols + '">';
    html += '<div class="compare-row" style="display:contents"><div class="cr-label"></div>' + unis.map(u => '<div class="cr-cell" style="font-weight:700;color:var(--text-primary);font-size:14px">' + u.name + '</div>').join('') + '</div>';
    fields.forEach(f => {
        const vals = unis.map(f.fn);
        html += '<div class="compare-row" style="display:contents"><div class="cr-label">' + f.label + '</div>';
        if (f.best === 'min') {
            const nums = vals.map(v => v === '-' ? Infinity : parseInt(v.replace('#', '')));
            const bestIdx = nums.indexOf(Math.min(...nums));
            html += unis.map((_, i) => '<div class="cr-cell' + (i === bestIdx ? ' best' : '') + '">' + vals[i] + '</div>').join('');
        } else {
            html += unis.map((_, i) => '<div class="cr-cell">' + vals[i] + '</div>').join('');
        }
        html += '</div>';
    });
    html += '</div></div>';
    document.getElementById('modalContent').innerHTML = html;
    document.getElementById('modalOverlay').classList.add('show');
}

function showDetailModal(id) {
    const u = allUniversities.find(x => x.id === id);
    if (!u) return;
    const zsbTag = u.isZsbTarget ? '<span class="tag tag-zsb" style="font-size:13px;padding:5px 14px;">可专升本</span>' : '';
    const rankHTML = u.rankSoft ? '<span class="rank-badge ' + (u.rankSoft <= 3 ? 'rank-' + u.rankSoft : 'rank-n') + '" style="width:40px;height:40px;font-size:16px;">' + u.rankSoft + '</span>' : '<span style="color:var(--text-muted)">无排名</span>';
    const typeTag = u.type === '本科' ? '<span class="tag tag-benke">本科</span>' : '<span class="tag tag-zhuanke">专科</span>';
    const natureTag = u.nature === '公办' ? '<span class="tag tag-public">公办</span>' : '<span class="tag tag-private">民办</span>';

    let html = '<div class="modal-head"><h2>🎓 ' + u.name + '</h2><button class="modal-close" onclick="closeModal()">×</button></div><div class="modal-body">';
    html += '<div class="detail-info-bar">' + rankHTML + typeTag + natureTag + zsbTag + '<span style="font-size:12px;color:var(--text-muted)">' + u.city + (u.district ? ' · ' + u.district : '') + '</span></div>';
    html += '<div class="detail-tabs">';
    html += '<button class="detail-tab-btn active" onclick="detailTabSwitch(\'overview\',this)">概况</button>';
    html += '<button class="detail-tab-btn" onclick="detailTabSwitch(\'major\',this)">专业</button>';
    html += '<button class="detail-tab-btn" onclick="detailTabSwitch(\'zsb\',this)">专升本数据</button>';
    html += '</div>';

    // Tab 1: Overview
    html += '<div class="detail-tab-panel active" id="detailTabOverview">';
    html += '<div class="detail-grid">';
    const items = [
        ['类型', u.type, 'highlight'], ['性质', u.nature, ''], ['城市', u.city, ''],
        ['层次', u.level || '-', ''], ['排名', u.rankSoft ? '#' + u.rankSoft : '未上榜', u.rankSoft && u.rankSoft <= 20 ? 'highlight' : ''],
        ['可专升本', u.isZsbTarget ? '是' : '否', u.isZsbTarget ? 'highlight' : ''],
        ['创办年份', u.foundedYear || '-', ''], ['在校人数', u.studentCount ? u.studentCount.toLocaleString() + '人' : '-', ''],
        ['官网', u.website ? '<a href="' + u.website + '" target="_blank" style="color:var(--blue);text-decoration:none;">访问官网 →</a>' : '-', '']
    ];
    items.forEach(function(item) {
        html += '<div class="detail-item"><div class="di-label">' + item[0] + '</div><div class="di-value ' + item[2] + '">' + item[1] + '</div></div>';
    });
    html += '</div>';
    if (u.longitude && u.latitude) {
        html += '<div id="detailMiniMap" class="detail-mini-map"></div>';
    }
    html += '</div>';

    // Tab 2: Major
    html += '<div class="detail-tab-panel" id="detailTabMajor">';
    html += '<div id="detailMajorContent"><div class="detail-empty">加载中...</div></div>';
    html += '</div>';

    // Tab 3: ZSB
    html += '<div class="detail-tab-panel" id="detailTabZsb">';
    if (u.isZsbTarget) {
        html += '<div id="detailZsbContent"><div class="detail-empty">加载中...</div></div>';
    } else {
        html += '<div class="detail-empty">该校不参与专升本招生</div>';
    }
    html += '</div>';

    html += '</div>';
    document.getElementById('modalContent').innerHTML = html;
    document.getElementById('modalOverlay').classList.add('show');

    // Load data for tabs
    if (u.longitude && u.latitude) {
        setTimeout(function() { renderDetailMiniMap(u.longitude, u.latitude, u.name); }, 100);
    }
    loadDetailMajors(id);
    if (u.isZsbTarget) { loadDetailZsbData(id); }
}
function closeModal() { document.getElementById('modalOverlay').classList.remove('show'); }

function detailTabSwitch(tabId, btn) {
    document.querySelectorAll('.detail-tab-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    document.querySelectorAll('.detail-tab-panel').forEach(function(p) { p.classList.remove('active'); });
    var panel = document.getElementById('detailTab' + tabId.charAt(0).toUpperCase() + tabId.slice(1));
    if (panel) panel.classList.add('active');
}

function renderDetailMiniMap(lng, lat, name) {
    var el = document.getElementById('detailMiniMap');
    if (!el) return;
    var chart = echarts.init(el);
    chart.setOption({
        geo: { map: 'guizhou', roam: false, zoom: 3, center: [lng, lat], itemStyle: { areaColor: '#1a2538', borderColor: '#2d3f5a' }, label: { show: false }, emphasis: { label: { show: false } } },
        series: [{ type: 'scatter', coordinateSystem: 'geo', data: [{ name: name, value: [lng, lat, 1] }], symbolSize: 16, itemStyle: { color: '#3b82f6', borderColor: '#fff', borderWidth: 2 }, label: { show: true, formatter: '{b}', position: 'right', color: '#e2e8f0', fontSize: 12, backgroundColor: 'rgba(0,0,0,0.6)', padding: [4,8], borderRadius: 4 } }]
    });
    window.addEventListener('resize', function() { chart.resize(); });
}

function loadDetailMajors(universityId) {
    var el = document.getElementById('detailMajorContent');
    if (!el) return;
    fetch(API + '/api/major/list?universityId=' + universityId)
        .then(function(r) { return r.json(); })
        .then(function(json) {
            var data = json.data || [];
            if (!data || data.length === 0) {
                el.innerHTML = '<div class="detail-empty">暂无专业数据</div>';
                return;
            }
            var html = '<table class="detail-plan-table"><thead><tr><th>专业名称</th><th>专业代码</th><th>层次</th></tr></thead><tbody>';
            data.forEach(function(m) {
                html += '<tr><td>' + (m.name || '-') + '</td><td>' + (m.code || '-') + '</td><td>' + (m.level || '-') + '</td></tr>';
            });
            html += '</tbody></table>';
            el.innerHTML = html;
        })
        .catch(function() {
            el.innerHTML = '<div class="detail-empty">暂无专业数据</div>';
        });
}

function loadDetailZsbData(universityId) {
    var el = document.getElementById('detailZsbContent');
    if (!el) return;
    var html = '';

    // Load plans
    fetch(API + '/api/zsb/plans?year=2026&page=1&size=200&universityId=' + universityId)
        .then(function(r) { return r.json(); })
        .then(function(json) {
            var plans = (json.data && json.data.records) ? json.data.records : [];
            if (plans.length > 0) {
                var totalPlans = plans.reduce(function(s, p) { return s + (p.planCount || 0); }, 0);
                var uniqueMajors = new Set(plans.map(function(p) { return p.majorName; })).size;
                html += '<div style="display:flex;gap:16px;margin-bottom:16px;">';
                html += '<div style="flex:1;background:rgba(59,130,246,0.1);border-radius:10px;padding:14px;text-align:center;"><div style="font-size:24px;font-weight:900;color:var(--blue);">' + totalPlans + '</div><div style="font-size:12px;color:var(--text-muted);">总招生计划</div></div>';
                html += '<div style="flex:1;background:rgba(245,158,11,0.1);border-radius:10px;padding:14px;text-align:center;"><div style="font-size:24px;font-weight:900;color:var(--orange);">' + uniqueMajors + '</div><div style="font-size:12px;color:var(--text-muted);">招生专业数</div></div>';
                html += '</div>';
                html += '<h4 style="font-size:14px;color:var(--text-secondary);margin-bottom:12px;">2026年招生计划明细</h4>';
                html += '<table class="detail-plan-table"><thead><tr><th>专业</th><th>类别</th><th>计划数</th><th>学费</th><th>学制</th></tr></thead><tbody>';
                plans.forEach(function(p) {
                    html += '<tr><td>' + (p.majorName || '-') + '</td><td>' + (p.category || '-') + '</td><td><strong>' + (p.planCount || '-') + '</strong></td><td>' + (p.tuition ? p.tuition.toLocaleString() : '-') + '</td><td>' + (p.duration || '-') + '</td></tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<div class="detail-empty">暂无2026年招生计划</div>';
            }

            // Load score trend
            return fetch(API + '/api/zsb/score-trend?universityId=' + universityId);
        })
        .then(function(r) { return r.json(); })
        .then(function(json) {
            var trend = json.data || [];
            if (trend.length > 0) {
                html += '<h4 style="font-size:14px;color:var(--text-secondary);margin:20px 0 12px;">历年分数线趋势</h4>';
                html += '<div id="detailScoreChart" class="detail-chart"></div>';
            }
            el.innerHTML = html;

            // Render chart if data exists
            if (trend.length > 0) {
                setTimeout(function() {
                    var chartEl = document.getElementById('detailScoreChart');
                    if (!chartEl) return;
                    var chart = echarts.init(chartEl);
                    chart.setOption({
                        tooltip: { trigger: 'axis' },
                        grid: { left: 50, right: 20, top: 20, bottom: 30 },
                        xAxis: { type: 'category', data: trend.map(function(d) { return d.year + '年'; }), axisLabel: { color: '#94a3b8' }, axisLine: { lineStyle: { color: '#1e293b' } } },
                        yAxis: { type: 'value', axisLabel: { color: '#64748b' }, splitLine: { lineStyle: { color: '#1e293b' } } },
                        series: [{ type: 'line', data: trend.map(function(d) { return d.totalScore; }), smooth: true, lineStyle: { width: 3, color: '#f59e0b' }, itemStyle: { color: '#f59e0b' }, areaStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: 'rgba(245,158,11,0.3)' }, { offset: 1, color: 'rgba(245,158,11,0)' }] } } }]
                    });
                    window.addEventListener('resize', function() { chart.resize(); });
                }, 100);
            }
        })
        .catch(function() {
            el.innerHTML = '<div class="detail-empty">暂无专升本数据</div>';
        });
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// ========== 智能筛选标签 ==========
let activeSmartTag = null;
function toggleSmartTag(el) {
    const tag = el.dataset.tag;
    if (activeSmartTag === tag) { activeSmartTag = null; el.classList.remove('active'); }
    else { document.querySelectorAll('.smart-tag').forEach(t => t.classList.remove('active')); activeSmartTag = tag; el.classList.add('active'); }
    currentPage = 1;
    renderTable();
}

// ========== 高校列表 ==========
function filterUniversities() { currentPage = 1; renderTable(); }
function setFilter(f, btn) { currentFilter = f; document.querySelectorAll('[data-filter]').forEach(b => b.classList.remove('active')); if (btn) btn.classList.add('active'); currentPage = 1; renderTable(); }

function getFiltered() {
    let list = [...allUniversities];
    const s = document.getElementById('searchInput').value.trim().toLowerCase();
    const c = document.getElementById('cityFilter').value;
    const n = document.getElementById('natureFilter').value;
    if (s) list = list.filter(u => u.name.toLowerCase().includes(s) || u.city.toLowerCase().includes(s) || (u.shortName||'').toLowerCase().includes(s));
    if (currentFilter === '本科') list = list.filter(u => u.type === '本科');
    if (currentFilter === '专科') list = list.filter(u => u.type === '专科');
    if (currentFilter === 'zsb') list = list.filter(u => u.isZsbTarget);
    if (c !== 'all') list = list.filter(u => u.city === c);
    if (n !== 'all') list = list.filter(u => u.nature === n);
    if (activeSmartTag === 'public') list = list.filter(u => u.nature === '公办');
    if (activeSmartTag === 'private') list = list.filter(u => u.nature === '民办' && u.type === '本科');
    if (activeSmartTag === 'top30') list = list.filter(u => u.rankSoft && u.rankSoft <= 30);
    if (activeSmartTag === 'capital') list = list.filter(u => u.city === '贵阳');
    if (activeSmartTag === 'zsbhigh') list = list.filter(u => u.isZsbTarget && u.rankSoft && u.rankSoft <= 30);
    return list;
}

function renderTable() {
    const filtered = getFiltered();
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    if (currentPage > totalPages) currentPage = totalPages || 1;
    const start = (currentPage - 1) * PAGE_SIZE;
    const page = filtered.slice(start, start + PAGE_SIZE);
    const tbody = document.getElementById('uniTbody');
    if (!page.length) { tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text-muted)">没有找到匹配的高校</td></tr>'; }
    else {
        tbody.innerHTML = page.map(u => `<tr><td><input type="checkbox" class="cb-check uni-cb" data-id="${u.id}" ${compareIds.has(u.id)?'checked':''} onchange="toggleCompare(${u.id})"></td><td>${u.rankSoft ? '<span class="rank-badge '+(u.rankSoft<=3?'rank-'+u.rankSoft:'rank-n')+'">'+u.rankSoft+'</span>' : '<span style="color:var(--text-muted)">-</span>'}</td><td class="uni-name" onclick="showDetailModal(${u.id})">${u.name}</td><td><span class="tag ${u.type==='本科'?'tag-benke':'tag-zhuanke'}">${u.type}</span></td><td><span class="tag ${u.nature==='公办'?'tag-public':'tag-private'}">${u.nature}</span></td><td>${u.city}</td><td>${u.level||'-'}</td><td>${u.isZsbTarget?'<span class="tag tag-zsb">是</span>':'<span style="color:var(--text-muted)">-</span>'}</td></tr>`).join('');
    }
    document.getElementById('tableInfo').textContent = '共 '+filtered.length+' 所高校，第 '+currentPage+'/'+(totalPages||1)+' 页';
    let ph = '<button class="page-btn" onclick="goPage('+(currentPage-1)+')" '+(currentPage<=1?'disabled':'')+'>上一页</button>';
    let sp = Math.max(1, currentPage - 2), ep = Math.min(totalPages, sp + 4);
    if (ep - sp < 4) sp = Math.max(1, ep - 4);
    for (let i = sp; i <= ep; i++) ph += '<button class="page-btn '+(i===currentPage?'active':'')+'" onclick="goPage('+i+')">'+i+'</button>';
    ph += '<button class="page-btn" onclick="goPage('+(currentPage+1)+')" '+(currentPage>=totalPages?'disabled':'')+'>下一页</button>';
    document.getElementById('pagination').innerHTML = ph;
}
function goPage(p) { currentPage = p; renderTable(); }

// ========== 地标列表 ==========
function initLandmarks() {
    document.getElementById('trainList').innerHTML = TRAIN_STATIONS.map(s => '<div class="landmark-item"><span class="lm-icon">🚄</span><div class="lm-info"><div class="lm-name">'+s.name+'</div><div class="lm-city">'+s.city+'</div></div></div>').join('');
    document.getElementById('mallList').innerHTML = MALL_AREAS.map(m => '<div class="landmark-item"><span class="lm-icon">🏙️</span><div class="lm-info"><div class="lm-name">'+m.name+'</div><div class="lm-city">'+m.city+'</div></div></div>').join('');
}

// ========== 窗口缩放 ==========
window.addEventListener('resize', () => {
    document.querySelectorAll('.chart-area').forEach(el => { const i = echarts.getInstanceByDom(el); if (i) i.resize(); });
});

init();
</script>
</body>
</html>
