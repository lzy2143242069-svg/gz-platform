<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>贵州高校数据平台</title>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #0b1120;
            --bg-card: #111827;
            --bg-card-hover: #1a2538;
            --border: rgba(255,255,255,0.06);
            --text-primary: #f0f4f8;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --blue: #3b82f6;
            --orange: #f59e0b;
            --green: #10b981;
            --red: #ef4444;
            --purple: #8b5cf6;
            --radius: 16px;
            --radius-sm: 10px;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Noto Sans SC', -apple-system, sans-serif;
            background: var(--bg-deep);
            color: var(--text-primary);
            min-height: 100vh;
        }
        /* === HEADER === */
        .hero {
            position: relative;
            padding: 48px 40px 32px;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(ellipse at 30% 50%, rgba(59,130,246,0.08) 0%, transparent 50%),
                        radial-gradient(ellipse at 70% 50%, rgba(245,158,11,0.06) 0%, transparent 50%);
            animation: heroGlow 20s ease-in-out infinite alternate;
        }
        @keyframes heroGlow { 0%{transform:translate(0)} 100%{transform:translate(-5%,3%)} }
        .hero-content { position:relative; max-width:1280px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; }
        .hero-left h1 { font-size:32px; font-weight:900; letter-spacing:2px; background:linear-gradient(135deg,#fff,#94a3b8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        .hero-left p { color:var(--text-secondary); margin-top:6px; font-size:14px; }
        /* === DAILY QUOTE === */
        .daily-quote {
            margin-top:14px; padding:12px 18px;
            background:linear-gradient(135deg,rgba(139,92,246,0.08),rgba(59,130,246,0.06));
            border-left:3px solid var(--purple); border-radius:0 10px 10px 0;
            max-width:480px;
        }
        .daily-quote .dq-text {
            font-size:14px; font-weight:500; color:var(--text-primary);
            line-height:1.6; font-style:italic;
        }
        .daily-quote .dq-author {
            font-size:12px; color:var(--text-muted); margin-top:6px;
        }
        .countdown-badge {
            display:flex; align-items:center; gap:16px;
            background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.2);
            padding:14px 24px; border-radius:var(--radius);
        }
        .countdown-badge .cd-label { font-size:13px; color:var(--orange); }
        .countdown-badge .cd-days { font-size:36px; font-weight:900; color:var(--orange); line-height:1; }
        .countdown-badge .cd-unit { font-size:14px; color:var(--text-secondary); margin-left:2px; }
        /* === NAV === */
        .nav-bar { position:sticky; top:0; z-index:100; background:rgba(11,17,32,0.85); backdrop-filter:blur(20px); border-bottom:1px solid var(--border); }
        .nav-inner { max-width:1280px; margin:0 auto; display:flex; gap:0; padding:0 40px; }
        .nav-tab { padding:14px 24px; font-size:14px; font-weight:500; color:var(--text-muted); cursor:pointer; border-bottom:2px solid transparent; transition:all 0.3s; white-space:nowrap; }
        .nav-tab:hover { color:var(--text-secondary); }
        .nav-tab.active { color:var(--blue); border-bottom-color:var(--blue); }
        /* === LAYOUT === */
        .container { max-width:1280px; margin:0 auto; padding:24px 40px 60px; }
        .tab-panel { display:none; animation:fadeUp 0.4s ease; }
        .tab-panel.active { display:block; }
        @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
        /* === STATS === */
        .stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px; }
        .stat-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:24px; position:relative; overflow:hidden; transition:transform 0.2s, border-color 0.3s; }
        .stat-card:hover { transform:translateY(-2px); border-color:rgba(255,255,255,0.12); }
        .stat-card .stat-icon { font-size:28px; margin-bottom:12px; }
        .stat-card .stat-num { font-size:36px; font-weight:900; line-height:1; }
        .stat-card .stat-label { font-size:13px; color:var(--text-muted); margin-top:6px; }
        .stat-card.blue .stat-num { color:var(--blue); }
        .stat-card.orange .stat-num { color:var(--orange); }
        .stat-card.green .stat-num { color:var(--green); }
        .stat-card.purple .stat-num { color:var(--purple); }
        .stat-card::after { content:''; position:absolute; top:-40%; right:-20%; width:120px; height:120px; border-radius:50%; opacity:0.04; }
        .stat-card.blue::after { background:var(--blue); }
        .stat-card.orange::after { background:var(--orange); }
        .stat-card.green::after { background:var(--green); }
        .stat-card.purple::after { background:var(--purple); }
        /* === QUICK LINKS === */
        .quick-links { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; }
        .quick-link { display:flex; align-items:center; gap:12px; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:16px; cursor:pointer; transition:all 0.2s; }
        .quick-link:hover { border-color:rgba(59,130,246,0.3); transform:translateY(-2px); }
        .quick-link .ql-icon { font-size:24px; }
        .quick-link .ql-text { font-size:13px; font-weight:500; }
        .quick-link .ql-desc { font-size:11px; color:var(--text-muted); margin-top:2px; }
        /* === ANNOUNCEMENTS === */
        .announce-section { margin-bottom:24px; }
        .section-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
        .section-head h2 { font-size:18px; font-weight:700; }
        .announce-list { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
        .announce-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:18px; cursor:pointer; transition:all 0.2s; }
        .announce-card:hover { border-color:rgba(59,130,246,0.3); background:var(--bg-card-hover); }
        .announce-card .a-tag { display:inline-block; padding:2px 8px; border-radius:4px; font-size:11px; font-weight:600; margin-bottom:8px; }
        .a-tag.hot { background:rgba(239,68,68,0.15); color:var(--red); }
        .a-tag.new { background:rgba(16,185,129,0.15); color:var(--green); }
        .a-tag.info { background:rgba(59,130,246,0.15); color:var(--blue); }
        .announce-card h4 { font-size:14px; font-weight:600; margin-bottom:6px; line-height:1.4; }
        .announce-card .a-date { font-size:12px; color:var(--text-muted); }
        /* === CHARTS === */
        .chart-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px; }
        .chart-box { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:16px; }
        .chart-box h3 { font-size:15px; font-weight:600; margin-bottom:12px; color:var(--text-secondary); }
        .chart-area { width:100%; height:380px; }
        .chart-full { grid-column:1 / -1; }
        /* === FILTER BAR === */
        .filter-bar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px; align-items:center; }
        .search-box { flex:1; min-width:200px; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:10px 16px; color:var(--text-primary); font-size:14px; outline:none; transition:border-color 0.2s; }
        .search-box::placeholder { color:var(--text-muted); }
        .search-box:focus { border-color:var(--blue); }
        .filter-btn { padding:10px 16px; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); color:var(--text-secondary); font-size:13px; cursor:pointer; transition:all 0.2s; }
        .filter-btn:hover { border-color:rgba(255,255,255,0.15); }
        .filter-btn.active { background:rgba(59,130,246,0.15); border-color:var(--blue); color:var(--blue); }
        .filter-select { padding:10px 16px; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); color:var(--text-secondary); font-size:13px; cursor:pointer; outline:none; }
        .filter-select option { background:var(--bg-deep); color:var(--text-primary); }
        /* === TABLE === */
        .table-wrap { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; }
        table { width:100%; border-collapse:collapse; }
        th { padding:12px 14px; text-align:left; font-size:12px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; background:rgba(255,255,255,0.02); border-bottom:1px solid var(--border); }
        td { padding:12px 14px; font-size:13px; border-bottom:1px solid var(--border); color:var(--text-secondary); }
        tr:last-child td { border-bottom:none; }
        tr:hover td { background:rgba(255,255,255,0.02); }
        .uni-name { font-weight:600; color:var(--text-primary); }
        .rank-badge { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:8px; font-size:12px; font-weight:700; }
        .rank-1 { background:linear-gradient(135deg,#fbbf24,#f59e0b); color:#000; }
        .rank-2 { background:linear-gradient(135deg,#d1d5db,#9ca3af); color:#000; }
        .rank-3 { background:linear-gradient(135deg,#cd7c2f,#b45309); color:#fff; }
        .rank-n { background:rgba(255,255,255,0.06); color:var(--text-muted); }
        .tag { display:inline-block; padding:3px 10px; border-radius:6px; font-size:11px; font-weight:500; }
        .tag-benke { background:rgba(59,130,246,0.12); color:var(--blue); }
        .tag-zhuanke { background:rgba(245,158,11,0.12); color:var(--orange); }
        .tag-zsb { background:rgba(16,185,129,0.12); color:var(--green); }
        .tag-public { background:rgba(139,92,246,0.12); color:var(--purple); }
        .tag-private { background:rgba(239,68,68,0.12); color:var(--red); }
        .page-info { padding:14px 16px; font-size:13px; color:var(--text-muted); display:flex; justify-content:space-between; align-items:center; }
        .pagination { display:flex; gap:6px; }
        .page-btn { padding:6px 12px; background:rgba(255,255,255,0.05); border:1px solid var(--border); border-radius:6px; color:var(--text-secondary); font-size:13px; cursor:pointer; transition:all 0.2s; }
        .page-btn:hover { border-color:var(--blue); color:var(--blue); }
        .page-btn.active { background:var(--blue); border-color:var(--blue); color:#fff; }
        .page-btn:disabled { opacity:0.3; cursor:not-allowed; }
        /* === LANDMARKS === */
        .landmarks-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px; }
        .landmark-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:20px; }
        .landmark-card h3 { font-size:15px; font-weight:600; margin-bottom:14px; }
        .landmark-list { display:flex; flex-direction:column; gap:8px; max-height:260px; overflow-y:auto; }
        .landmark-item { display:flex; align-items:center; gap:10px; padding:10px 12px; background:rgba(255,255,255,0.02); border-radius:8px; transition:background 0.2s; }
        .landmark-item:hover { background:rgba(255,255,255,0.05); }
        .landmark-item .lm-icon { font-size:18px; }
        .landmark-item .lm-info { flex:1; }
        .landmark-item .lm-name { font-size:13px; font-weight:500; }
        .landmark-item .lm-city { font-size:11px; color:var(--text-muted); }
        /* === ZSB === */
        .zsb-hero { text-align:center; padding:48px 24px; background:linear-gradient(135deg,rgba(245,158,11,0.08),rgba(239,68,68,0.05)); border:1px solid rgba(245,158,11,0.15); border-radius:var(--radius); margin-bottom:24px; position:relative; overflow:hidden; }
        .zsb-hero::before { content:''; position:absolute; top:-50%; right:-30%; width:300px; height:300px; background:radial-gradient(circle,rgba(245,158,11,0.1),transparent 70%); border-radius:50%; }
        .zsb-hero h2 { font-size:22px; font-weight:700; margin-bottom:8px; position:relative; }
        .zsb-countdown { display:flex; justify-content:center; gap:20px; margin:24px 0; position:relative; }
        .zsb-cd-block { background:rgba(0,0,0,0.3); border:1px solid rgba(245,158,11,0.2); border-radius:12px; padding:16px 24px; min-width:80px; }
        .zsb-cd-block .cd-num { font-size:40px; font-weight:900; color:var(--orange); line-height:1; }
        .zsb-cd-block .cd-label { font-size:12px; color:var(--text-muted); margin-top:4px; }
        .zsb-info-cards { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; }
        .zsb-info-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:18px; text-align:center; }
        .zsb-info-card .zi-num { font-size:28px; font-weight:900; color:var(--blue); }
        /* === SMART TAGS === */
        .smart-tags { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
        .smart-tag { padding:7px 16px; background:rgba(255,255,255,0.04); border:1px solid var(--border); border-radius:20px; font-size:12px; color:var(--text-secondary); cursor:pointer; transition:all 0.2s; white-space:nowrap; }
        .smart-tag:hover { border-color:var(--blue); color:var(--blue); background:rgba(59,130,246,0.08); }
        .smart-tag.active { background:rgba(59,130,246,0.15); border-color:var(--blue); color:var(--blue); font-weight:600; }
        /* === COMPARE BAR === */
        .compare-bar { position:fixed; bottom:0; left:0; right:0; z-index:200; background:rgba(15,23,42,0.95); backdrop-filter:blur(12px); border-top:1px solid var(--blue); padding:14px 40px; display:flex; align-items:center; gap:16px; transform:translateY(100%); transition:transform 0.3s; }
        .compare-bar.show { transform:translateY(0); }
        .compare-bar .cb-count { font-size:14px; color:var(--text-secondary); }
        .compare-bar .cb-count strong { color:var(--blue); }
        .compare-bar .cb-names { flex:1; display:flex; gap:8px; flex-wrap:wrap; }
        .compare-bar .cb-name { padding:4px 12px; background:rgba(59,130,246,0.12); border-radius:6px; font-size:12px; color:var(--blue); display:flex; align-items:center; gap:6px; }
        .compare-bar .cb-name .cb-rm { cursor:pointer; opacity:0.7; }
        .compare-bar .cb-name .cb-rm:hover { opacity:1; }
        .cb-btn { padding:8px 20px; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; border:none; transition:all 0.2s; }
        .cb-btn-primary { background:var(--blue); color:#fff; }
        .cb-btn-primary:hover { background:#2563eb; }
        .cb-btn-primary:disabled { opacity:0.4; cursor:not-allowed; }
        .cb-btn-clear { background:transparent; border:1px solid var(--border); color:var(--text-secondary); }
        /* === MODAL === */
        .modal-overlay { position:fixed; inset:0; z-index:300; background:rgba(0,0,0,0.7); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity 0.25s; }
        .modal-overlay.show { opacity:1; pointer-events:auto; }
        .modal { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); max-width:900px; width:92vw; max-height:85vh; overflow-y:auto; padding:0; }
        .modal-head { display:flex; align-items:center; justify-content:space-between; padding:20px 24px; border-bottom:1px solid var(--border); position:sticky; top:0; background:var(--bg-card); z-index:1; }
        .modal-head h2 { font-size:18px; font-weight:700; }
        .modal-close { width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:8px; background:rgba(255,255,255,0.06); color:var(--text-secondary); cursor:pointer; font-size:18px; border:none; }
        .modal-body { padding:24px; }
        .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
        .detail-item { background:rgba(255,255,255,0.03); border-radius:10px; padding:14px 16px; }
        .detail-item .di-label { font-size:11px; color:var(--text-muted); margin-bottom:4px; text-transform:uppercase; letter-spacing:0.5px; }
        .detail-item .di-value { font-size:15px; font-weight:600; color:var(--text-primary); }
        .detail-item .di-value.highlight { color:var(--blue); }
        /* Detail Page Tabs */
        .detail-tabs { display:flex; gap:0; border-bottom:1px solid var(--border); margin-bottom:20px; }
        .detail-tab-btn { padding:12px 20px; font-size:13px; font-weight:500; color:var(--text-muted); cursor:pointer; border:none; background:none; border-bottom:2px solid transparent; transition:all 0.2s; }
        .detail-tab-btn:hover { color:var(--text-secondary); }
        .detail-tab-btn.active { color:var(--blue); border-bottom-color:var(--blue); }
        .detail-tab-panel { display:none; animation:fadeUp 0.3s ease; }
        .detail-tab-panel.active { display:block; }
        .detail-mini-map { width:100%; height:200px; border-radius:10px; margin-bottom:16px; background:var(--bg-deep); }
        .detail-plan-table { width:100%; border-collapse:collapse; font-size:13px; }
        .detail-plan-table th { padding:10px 12px; text-align:left; font-size:11px; color:var(--text-muted); background:rgba(255,255,255,0.02); border-bottom:1px solid var(--border); }
        .detail-plan-table td { padding:10px 12px; border-bottom:1px solid var(--border); color:var(--text-secondary); }
        .detail-chart { width:100%; height:250px; }
        .detail-empty { text-align:center; padding:40px 20px; color:var(--text-muted); font-size:14px; }
        .detail-info-bar { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
        .compare-grid { display:grid; gap:0; }
        .compare-row { display:grid; border-bottom:1px solid var(--border); }
        .compare-row .cr-label { padding:12px 16px; font-size:12px; color:var(--text-muted); font-weight:600; background:rgba(255,255,255,0.02); }
        .compare-row .cr-cell { padding:12px 16px; font-size:13px; color:var(--text-secondary); text-align:center; }
        .compare-row .cr-cell.best { color:var(--green); font-weight:700; }
        .cb-check { width:16px; height:16px; accent-color:var(--blue); cursor:pointer; }
        /* === DETAIL LINK === */
        .uni-name { cursor:pointer; }
        .uni-name:hover { color:var(--blue); text-decoration:underline; }
        .zsb-info-card .zi-label { font-size:12px; color:var(--text-muted); margin-top:4px; }
        /* === FAQ === */
        .faq-section { margin-top:24px; }
        .faq-item { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); margin-bottom:8px; overflow:hidden; }
        .faq-q { display:flex; align-items:center; justify-content:space-between; padding:14px 18px; cursor:pointer; font-size:14px; font-weight:500; color:var(--text-primary); transition:background 0.2s; }
        .faq-q:hover { background:rgba(255,255,255,0.03); }
        .faq-q .faq-arrow { transition:transform 0.3s; color:var(--text-muted); font-size:12px; }
        .faq-item.open .faq-q .faq-arrow { transform:rotate(90deg); }
        .faq-a { max-height:0; overflow:hidden; transition:max-height 0.3s ease; }
        .faq-item.open .faq-a { max-height:300px; }
        .faq-a-inner { padding:0 18px 14px; font-size:13px; color:var(--text-secondary); line-height:1.8; }
        .faq-a-inner strong { color:var(--orange); }
        /* === FLASHCARD === */
        .flashcard-section { margin-top:24px; }
        .flashcard-container { display:flex; align-items:center; justify-content:center; gap:20px; margin:20px 0; }
        .flashcard { width:360px; height:220px; perspective:800px; cursor:pointer; }
        .flashcard-inner { width:100%; height:100%; position:relative; transition:transform 0.5s; transform-style:preserve-3d; }
        .flashcard.flipped .flashcard-inner { transform:rotateY(180deg); }
        .flashcard-front, .flashcard-back { position:absolute; inset:0; backface-visibility:hidden; border-radius:var(--radius); display:flex; flex-direction:column; align-items:center; justify-content:center; padding:24px; }
        .flashcard-front { background:linear-gradient(135deg,#1e293b,#0f172a); border:2px solid rgba(59,130,246,0.3); }
        .flashcard-front .fc-word { font-size:36px; font-weight:900; color:var(--text-primary); letter-spacing:1px; }
        .flashcard-front .fc-phonetic { font-size:14px; color:var(--text-muted); margin-top:8px; }
        .flashcard-front .fc-hint { font-size:12px; color:var(--text-muted); margin-top:16px; }
        .flashcard-back { background:linear-gradient(135deg,#1a2538,#111827); border:2px solid rgba(245,158,11,0.3); transform:rotateY(180deg); }
        .flashcard-back .fc-meaning { font-size:20px; font-weight:700; color:var(--orange); text-align:center; }
        .flashcard-back .fc-example { font-size:13px; color:var(--text-secondary); margin-top:12px; text-align:center; line-height:1.6; }
        .fc-nav { display:flex; flex-direction:column; gap:10px; }
        .fc-btn { width:44px; height:44px; border-radius:12px; background:var(--bg-card); border:1px solid var(--border); color:var(--text-secondary); font-size:20px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s; }
        .fc-btn:hover { border-color:var(--blue); color:var(--blue); }
        .fc-progress { text-align:center; margin-top:16px; }
        .fc-progress-bar { width:360px; height:6px; background:rgba(255,255,255,0.06); border-radius:3px; margin:0 auto 8px; overflow:hidden; }
        .fc-progress-fill { height:100%; background:linear-gradient(90deg,var(--blue),var(--purple)); border-radius:3px; transition:width 0.3s; }
        .fc-progress-text { font-size:13px; color:var(--text-muted); }
        .fc-controls { display:flex; gap:10px; justify-content:center; margin-top:14px; }
        .fc-ctrl-btn { padding:8px 18px; border-radius:8px; font-size:13px; cursor:pointer; border:1px solid var(--border); background:var(--bg-card); color:var(--text-secondary); transition:all 0.2s; }
        .fc-ctrl-btn:hover { border-color:var(--blue); color:var(--blue); }
        .fc-ctrl-btn.active { background:rgba(59,130,246,0.15); border-color:var(--blue); color:var(--blue); }
        /* === SCORE ESTIMATOR === */
        .score-section { margin-top:24px; }
        .score-form { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; margin-bottom:20px; }
        .score-field { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px; }
        .score-field label { display:block; font-size:12px; color:var(--text-muted); margin-bottom:6px; }
        .score-field input { width:100%; background:rgba(255,255,255,0.04); border:1px solid var(--border); border-radius:8px; padding:10px 14px; color:var(--text-primary); font-size:18px; font-weight:700; text-align:center; outline:none; transition:border-color 0.2s; }
        .score-field input:focus { border-color:var(--blue); }
        .score-field .sf-max { font-size:11px; color:var(--text-muted); text-align:center; margin-top:4px; }
        .score-result { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:24px; }
        .score-total { text-align:center; margin-bottom:20px; }
        .score-total .st-num { font-size:56px; font-weight:900; line-height:1; }
        .score-total .st-label { font-size:14px; color:var(--text-muted); margin-top:6px; }
        .score-bars { display:flex; flex-direction:column; gap:10px; }
        .score-bar-item { display:flex; align-items:center; gap:12px; }
        .score-bar-label { width:70px; font-size:12px; color:var(--text-muted); text-align:right; }
        .score-bar-track { flex:1; height:24px; background:rgba(255,255,255,0.04); border-radius:6px; overflow:hidden; position:relative; }
        .score-bar-fill { height:100%; border-radius:6px; transition:width 0.5s; display:flex; align-items:center; justify-content:flex-end; padding-right:8px; font-size:11px; font-weight:600; color:#fff; }
        .score-bar-line { position:absolute; top:0; bottom:0; width:2px; background:var(--orange); z-index:1; }
        .score-bar-line-label { position:absolute; top:-16px; font-size:10px; color:var(--orange); white-space:nowrap; transform:translateX(-50%); }
        .score-schools { margin-top:20px; }
        .score-school-tag { display:inline-block; padding:5px 12px; margin:4px; border-radius:20px; font-size:12px; font-weight:500; }
        .score-school-safe { background:rgba(16,185,129,0.15); color:var(--green); border:1px solid rgba(16,185,129,0.3); }
        .score-school-mid { background:rgba(245,158,11,0.15); color:var(--orange); border:1px solid rgba(245,158,11,0.3); }
        .score-school-risk { background:rgba(239,68,68,0.15); color:var(--red); border:1px solid rgba(239,68,68,0.3); }
        /* === RESPONSIVE === */
        @media (max-width:900px) {
            .hero { padding:32px 20px 24px; }
            .hero-content { flex-direction:column; align-items:flex-start; }
            .container { padding:16px 20px 40px; }
            .nav-inner { padding:0 20px; overflow-x:auto; }
            .stats-grid,.quick-links { grid-template-columns:repeat(2,1fr); }
            .chart-grid,.landmarks-grid { grid-template-columns:1fr; }
            .announce-list { grid-template-columns:1fr; }
            .zsb-info-cards { grid-template-columns:repeat(2,1fr); }
        }
        ::-webkit-scrollbar { width:6px; height:6px; }
        ::-webkit-scrollbar-track { background:transparent; }
        ::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.1); border-radius:3px; }
    </style>
</head>
<body>

<!-- HEADER -->
<div class="hero">
    <div class="hero-content">
        <div class="hero-left">
            <h1>贵州高校数据平台</h1>
            <p>覆盖全省 80 所高校 · 专升本数据一站式查询 · 数据实时可视化</p>
            <div class="daily-quote" id="dailyQuote"></div>
        </div>
        <div class="countdown-badge">
            <div>
                <div class="cd-label">距离 2027 专升本考试</div>
                <div style="display:flex;align-items:baseline;gap:4px;margin-top:4px;">
                    <span class="cd-days" id="headerDays">--</span>
                    <span class="cd-unit">天</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NAV -->
<div class="nav-bar">
    <div class="nav-inner">
        <div class="nav-tab active" data-tab="home">首页概览</div>
        <div class="nav-tab" data-tab="map">高校地图</div>
        <div class="nav-tab" data-tab="zsb">专升本专区</div>
        <div class="nav-tab" data-tab="list">高校列表</div>
    </div>
</div>

<!-- CONTENT -->
<div class="container">

    <!-- TAB 1: 首页 -->
    <div class="tab-panel active" id="tab-home">
        <div class="stats-grid">
            <div class="stat-card blue"><div class="stat-icon">🎓</div><div class="stat-num" id="sTotal">--</div><div class="stat-label">高校总数</div></div>
            <div class="stat-card green"><div class="stat-icon">📘</div><div class="stat-num" id="sBenke">--</div><div class="stat-label">本科院校</div></div>
            <div class="stat-card orange"><div class="stat-icon">📗</div><div class="stat-num" id="sZhuanke">--</div><div class="stat-label">专科院校</div></div>
            <div class="stat-card purple"><div class="stat-icon">🚀</div><div class="stat-num" id="sZsb">--</div><div class="stat-label">可专升本院校</div></div>
        </div>
        <div class="quick-links">
            <div class="quick-link" onclick="switchTab('map')"><div class="ql-icon">🗺️</div><div><div class="ql-text">高校地图</div><div class="ql-desc">查看全省高校分布</div></div></div>
            <div class="quick-link" onclick="switchTab('zsb')"><div class="ql-icon">📊</div><div><div class="ql-text">专升本专区</div><div class="ql-desc">分数线 · 招生计划</div></div></div>
            <div class="quick-link" onclick="switchTab('list')"><div class="ql-icon">📋</div><div><div class="ql-text">高校列表</div><div class="ql-desc">全部 80 所高校</div></div></div>
            <div class="quick-link" onclick="switchTab('list');setTimeout(()=>document.getElementById('searchInput').focus(),300)"><div class="ql-icon">🔍</div><div><div class="ql-text">搜索高校</div><div class="ql-desc">按名称/城市搜索</div></div></div>
        </div>
        <div class="announce-section">
            <div class="section-head"><h2>📢 最新公告</h2></div>
            <div class="announce-list">
                <div class="announce-card"><span class="a-tag hot">重要</span><h4>2026 年贵州省专升本考试录取工作已结束</h4><div class="a-date">2026-06-01</div></div>
                <div class="announce-card"><span class="a-tag new">最新</span><h4>平台已收录全省 80 所高校真实地理坐标</h4><div class="a-date">2026-06-11</div></div>
                <div class="announce-card"><span class="a-tag info">通知</span><h4>专升本历年分数线数据正在采集中，敬请期待</h4><div class="a-date">2026-06-11</div></div>
            </div>
        </div>
        <div class="chart-grid">
            <div class="chart-box"><h3>各市高校数量分布</h3><div id="homeBarChart" class="chart-area"></div></div>
            <div class="chart-box"><h3>高校类型分布</h3><div id="homePieChart" class="chart-area"></div></div>
        </div>
    </div>

    <!-- TAB 2: 地图 -->
    <div class="tab-panel" id="tab-map">
        <div class="filter-bar">
            <button class="filter-btn active" data-layer="all" onclick="setMapLayer('all',this)">全部标注</button>
            <button class="filter-btn" data-layer="uni" onclick="setMapLayer('uni',this)">仅高校</button>
            <button class="filter-btn" data-layer="train" onclick="setMapLayer('train',this)">高铁站</button>
            <button class="filter-btn" data-layer="mall" onclick="setMapLayer('mall',this)">繁华商圈</button>
            <select class="filter-select" id="mapCityFilter" onchange="filterMapByCity(this.value)"><option value="all">全部城市</option></select>
        </div>
        <div class="chart-box"><div id="mapChart" class="chart-area" style="height:520px;"></div></div>
        <div class="landmarks-grid">
            <div class="landmark-card"><h3>🚄 贵州主要高铁站</h3><div class="landmark-list" id="trainList"></div></div>
            <div class="landmark-card"><h3>🏙️ 主要繁华商圈</h3><div class="landmark-list" id="mallList"></div></div>
        </div>
    </div>

    <!-- TAB 3: 专升本 -->
    <div class="tab-panel" id="tab-zsb">
        <div class="zsb-hero">
            <h2>2027 贵州省普通高校专升本考试</h2>
            <p style="color:var(--text-secondary);font-size:14px;">预计考试时间：2027 年 4 月中旬</p>
            <div class="zsb-countdown">
                <div class="zsb-cd-block"><div class="cd-num" id="zDays">--</div><div class="cd-label">天</div></div>
                <div class="zsb-cd-block"><div class="cd-num" id="zHours">--</div><div class="cd-label">时</div></div>
                <div class="zsb-cd-block"><div class="cd-num" id="zMins">--</div><div class="cd-label">分</div></div>
                <div class="zsb-cd-block"><div class="cd-num" id="zSecs">--</div><div class="cd-label">秒</div></div>
            </div>
        </div>
        <div class="zsb-info-cards">
            <div class="zsb-info-card"><div class="zi-num">32</div><div class="zi-label">招生院校数</div></div>
            <div class="zsb-info-card"><div class="zi-num" style="color:var(--orange)" id="zsbPlanTotal">--</div><div class="zi-label">招生计划总数</div></div>
            <div class="zsb-info-card"><div class="zi-num" style="color:var(--green)" id="zsbMajorTotal">--</div><div class="zi-label">招生专业数</div></div>
            <div class="zsb-info-card" style="text-align:left;padding-left:20px;"><div class="zi-label" style="margin-bottom:6px;">2026年省控线</div><div style="display:flex;flex-wrap:wrap;gap:4px 12px;font-size:12px;"><span>文史 <strong style="color:var(--orange)">99</strong></span><span>理工 <strong style="color:var(--blue)">49</strong></span><span>艺术文 <strong style="color:var(--purple)">70</strong></span><span>艺术理 <strong style="color:var(--purple)">37</strong></span><span>体育文 <strong style="color:var(--green)">70</strong></span><span>体育理 <strong style="color:var(--green)">36</strong></span></div></div>
        </div>
        <div class="announce-section">
            <div class="section-head"><h2>📚 备考资源</h2></div>
            <div class="announce-list" style="grid-template-columns:repeat(4,1fr);">
                <a href="https://www.bilibili.com/search?keyword=贵州专升本英语" target="_blank" class="announce-card" style="text-decoration:none;border-left:3px solid var(--blue);"><span class="a-tag info">B站</span><h4>专升本英语课程</h4><div class="a-date">免费视频 · 语法+阅读+写作</div></a>
                <a href="https://www.bilibili.com/search?keyword=贵州专升本大学语文" target="_blank" class="announce-card" style="text-decoration:none;border-left:3px solid var(--orange);"><span class="a-tag hot">B站</span><h4>大学语文精讲</h4><div class="a-date">免费视频 · 古文+现代文+作文</div></a>
                <a href="https://www.bilibili.com/search?keyword=贵州专升本高等数学" target="_blank" class="announce-card" style="text-decoration:none;border-left:3px solid var(--green);"><span class="a-tag new">B站</span><h4>高等数学网课</h4><div class="a-date">免费视频 · 微积分+线代+概率</div></a>
                <a href="https://zsksy.guizhou.gov.cn" target="_blank" class="announce-card" style="text-decoration:none;border-left:3px solid var(--purple);"><span class="a-tag info">官网</span><h4>贵州招生考试院</h4><div class="a-date">政策公告 · 报名入口 · 成绩查询</div></a>
            </div>
        </div>
        <div class="announce-section">
            <div class="section-head"><h2>专升本时间线</h2></div>
            <div class="announce-list" style="grid-template-columns:repeat(4,1fr);">
                <div class="announce-card" style="border-left:3px solid var(--blue);"><span class="a-tag info">1月</span><h4>发布招生简章</h4><div class="a-date">各校公布招生计划和专业</div></div>
                <div class="announce-card" style="border-left:3px solid var(--orange);"><span class="a-tag hot">3月</span><h4>统一考试</h4><div class="a-date">文化课 + 专业课考试</div></div>
                <div class="announce-card" style="border-left:3px solid var(--green);"><span class="a-tag new">4月</span><h4>成绩公布</h4><div class="a-date">查询成绩，公布省控线</div></div>
                <div class="announce-card" style="border-left:3px solid var(--purple);"><span class="a-tag info">5-6月</span><h4>录取通知</h4><div class="a-date">志愿填报，录取结果公布</div></div>
            </div>
        </div>
        <div class="chart-grid">
            <div class="chart-box chart-full"><h3>专升本分数线趋势</h3><div id="zsbTrendChart" class="chart-area"></div></div>
        </div>
        <h3 style="font-size:16px;font-weight:600;margin:20px 0 12px;">可报考院校（32所）</h3>
        <div class="table-wrap"><table><thead><tr><th>排名</th><th>院校</th><th>类型</th><th>性质</th><th>城市</th><th>层次</th></tr></thead><tbody id="zsbTbody"></tbody></table></div>

        <h3 style="font-size:16px;font-weight:600;margin:24px 0 12px;">2026 年招生计划（<span id="planCountLabel">加载中</span>）</h3>
        <div class="filter-bar" style="margin-bottom:12px;">
            <input type="text" class="search-box" id="planSearch" placeholder="搜索专业名称..." oninput="filterPlans()">
            <select class="filter-select" id="planUniFilter" onchange="filterPlans()"><option value="all">全部院校</option></select>
            <select class="filter-select" id="planCatFilter" onchange="filterPlans()"><option value="all">全部类别</option></select>
        </div>
        <div class="table-wrap">
            <table><thead><tr><th>院校</th><th>专业</th><th>类别</th><th>计划数</th><th>学费(元/年)</th><th>学制</th><th>联合培养点</th></tr></thead><tbody id="planTbody"></tbody></table>
            <div class="page-info"><span id="planInfo">加载中...</span><div class="pagination" id="planPagination"></div></div>
        </div>

        <div class="chart-grid" style="margin-top:24px;">
            <div class="chart-box chart-full"><h3>📊 各校招生计划数 Top10</h3><div id="planByUniChart" style="width:100%;height:650px"></div></div>
            <div class="chart-box chart-full"><h3>📊 热门招生专业 Top10</h3><div id="planByMajorChart" style="width:100%;height:650px"></div></div>
        </div>

        <div class="faq-section">
            <div class="section-head"><h2>❓ 专升本报考常见问题</h2></div>
            <div class="faq-item"><div class="faq-q" onclick="this.parentElement.classList.toggle('open')">什么是专升本？<span class="faq-arrow">▶</span></div><div class="faq-a"><div class="faq-a-inner">专升本是指普通高职（专科）毕业生通过考试进入普通本科高校继续学习的选拔性考试。毕业后获得<strong>全日制本科学历</strong>，第一学历为本科，与高考统招本科具有同等效力。</div></div></div>
            <div class="faq-item"><div class="faq-q" onclick="this.parentElement.classList.toggle('open')">贵州专升本考试科目有哪些？<span class="faq-arrow">▶</span></div><div class="faq-a"><div class="faq-a-inner">考试分为<strong>文化课</strong>和<strong>专业课</strong>两部分。文化课考英语和大学语文（文科）或高等数学（理科），每科150分，总分300分。专业课由各招生院校自主命题，一般在文化课考试后进行。</div></div></div>
            <div class="faq-item"><div class="faq-q" onclick="this.parentElement.classList.toggle('open')">哪些人可以报考？<span class="faq-arrow">▶</span></div><div class="faq-a"><div class="faq-a-inner">贵州省普通高校全日制高职（专科）应届毕业生，以及符合条件的退役大学生士兵。在校期间无记过及以上处分，思想品德良好。<strong>每人只有一次报考机会</strong>（退役士兵除外）。</div></div></div>
            <div class="faq-item"><div class="faq-q" onclick="this.parentElement.classList.toggle('open')">可以跨专业报考吗？<span class="faq-arrow">▶</span></div><div class="faq-a"><div class="faq-a-inner">部分专业有对口限制，需要参照当年公布的<strong>专业对照表</strong>。一般来说，报考专业应与高职所学专业相同或相近。具体以当年招生简章为准。</div></div></div>
            <div class="faq-item"><div class="faq-q" onclick="this.parentElement.classList.toggle('open')">退役士兵有什么优惠政策？<span class="faq-arrow">▶</span></div><div class="faq-a"><div class="faq-a-inner">退役大学生士兵可享受<strong>免试专升本</strong>政策，需在规定时间内向所在院校提出申请，并提交退役证、身份证等材料。具体政策每年可能调整，建议关注省招生考试院公告。</div></div></div>
            <div class="faq-item"><div class="faq-q" onclick="this.parentElement.classList.toggle('open')">专升本学历含金量如何？<span class="faq-arrow">▶</span></div><div class="faq-a"><div class="faq-a-inner">专升本毕业后获得<strong>全日制普通本科毕业证书</strong>和<strong>学士学位证书</strong>，在考公、考研、就业等方面与四年制本科具有同等法律效力。第一学历为本科，不标注"专升本"。</div></div></div>
            <div class="faq-item"><div class="faq-q" onclick="this.parentElement.classList.toggle('open')">什么时候开始准备比较好？<span class="faq-arrow">▶</span></div><div class="faq-a"><div class="faq-a-inner">建议<strong>大二下学期</strong>开始了解政策和确定目标院校，大三上学期系统复习。英语需要长期积累，越早准备越好。不要只顾专业课忽视文化课，两部分都很重要。</div></div></div>
            <div class="faq-item"><div class="faq-q" onclick="this.parentElement.classList.toggle('open')">可以报考省外院校吗？<span class="faq-arrow">▶</span></div><div class="faq-a"><div class="faq-a-inner"><strong>不可以</strong>。贵州专升本只能报考贵州省内招生院校，不能跨省报考。2026年共有32所省内院校招收专升本学生。</div></div></div>
        </div>

        <!-- 单词卡片 -->
        <div class="flashcard-section">
            <div class="section-head"><h2>📝 专升本英语单词卡片</h2></div>
            <div class="fc-controls">
                <button class="fc-ctrl-btn active" onclick="setWordGroup('core')">核心词汇</button>
                <button class="fc-ctrl-btn" onclick="setWordGroup('high')">高频词汇</button>
                <button class="fc-ctrl-btn" onclick="setWordGroup('phrase')">常考短语</button>
            </div>
            <div class="flashcard-container">
                <div class="fc-nav"><button class="fc-btn" onclick="prevWord()">◀</button></div>
                <div class="flashcard" id="flashcard" onclick="this.classList.toggle('flipped')">
                    <div class="flashcard-inner">
                        <div class="flashcard-front"><div class="fc-word" id="fcWord">abandon</div><div class="fc-phonetic" id="fcPhonetic">/əˈbændən/</div><div class="fc-hint">点击翻转查看释义</div></div>
                        <div class="flashcard-back"><div class="fc-meaning" id="fcMeaning">v. 放弃；抛弃</div><div class="fc-example" id="fcExample">He abandoned his plan to travel abroad.</div></div>
                    </div>
                </div>
                <div class="fc-nav"><button class="fc-btn" onclick="nextWord()">▶</button></div>
            </div>
            <div class="fc-progress"><div class="fc-progress-bar"><div class="fc-progress-fill" id="fcProgressFill" style="width:0%"></div></div><div class="fc-progress-text" id="fcProgressText">1 / 50</div></div>
        </div>

        <!-- 估分系统 -->
        <div class="score-section">
            <div class="section-head"><h2>🎯 专升本估分系统</h2></div>
            <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px;">贵州专升本总分450分 = 文化课300分（英语150+语文/数学150）+ 专业课150分</p>
            <div class="score-form">
                <div class="score-field"><label>英语（满分150）</label><input type="number" id="scoreEnglish" min="0" max="150" placeholder="0" oninput="calcScore()"><div class="sf-max">满分 150 分</div></div>
                <div class="score-field"><label>大学语文 / 高等数学（满分150）</label><input type="number" id="scoreMajor" min="0" max="150" placeholder="0" oninput="calcScore()"><div class="sf-max">满分 150 分</div></div>
                <div class="score-field"><label>专业课（满分150）</label><input type="number" id="scoreProf" min="0" max="150" placeholder="0" oninput="calcScore()"><div class="sf-max">各校自主命题 · 满分 150 分</div></div>
            </div>
            <div class="score-result" id="scoreResult" style="display:none;">
                <div style="display:flex;gap:20px;margin-bottom:20px;">
                    <div class="score-total" style="flex:1"><div class="st-num" id="scoreTotalNum" style="color:var(--blue)">0</div><div class="st-label">总分（满分450）</div></div>
                    <div class="score-total" style="flex:1"><div class="st-num" id="scoreCultureNum" style="color:var(--orange);font-size:40px">0</div><div class="st-label">文化课（满分300）</div></div>
                </div>
                <div style="margin-bottom:16px;"><h4 style="font-size:14px;color:var(--text-secondary);margin-bottom:10px;">📊 文化课 vs 省控线</h4>
                    <div class="score-bars">
                        <div class="score-bar-item"><span class="score-bar-label">文史类</span><div class="score-bar-track"><div class="score-bar-line" id="lineWenshi" style="left:33%"><div class="score-bar-line-label">99分</div></div><div class="score-bar-fill" id="barWenshi" style="width:0%;background:var(--orange)"></div></div></div>
                        <div class="score-bar-item"><span class="score-bar-label">理工类</span><div class="score-bar-track"><div class="score-bar-line" id="lineLigong" style="left:16.3%"><div class="score-bar-line-label">49分</div></div><div class="score-bar-fill" id="barLigong" style="width:0%;background:var(--blue)"></div></div></div>
                        <div class="score-bar-item"><span class="score-bar-label">艺术文</span><div class="score-bar-track"><div class="score-bar-line" id="lineYishuW" style="left:23.3%"><div class="score-bar-line-label">70分</div></div><div class="score-bar-fill" id="barYishuW" style="width:0%;background:var(--purple)"></div></div></div>
                        <div class="score-bar-item"><span class="score-bar-label">艺术理</span><div class="score-bar-track"><div class="score-bar-line" id="lineYishuL" style="left:12.3%"><div class="score-bar-line-label">37分</div></div><div class="score-bar-fill" id="barYishuL" style="width:0%;background:var(--purple)"></div></div></div>
                        <div class="score-bar-item"><span class="score-bar-label">体育文</span><div class="score-bar-track"><div class="score-bar-line" id="lineTyuW" style="left:23.3%"><div class="score-bar-line-label">70分</div></div><div class="score-bar-fill" id="barTyuW" style="width:0%;background:var(--green)"></div></div></div>
                        <div class="score-bar-item"><span class="score-bar-label">体育理</span><div class="score-bar-track"><div class="score-bar-line" id="lineTyuL" style="left:12%"><div class="score-bar-line-label">36分</div></div><div class="score-bar-fill" id="barTyuL" style="width:0%;background:var(--green)"></div></div></div>
                    </div>
                </div>
                <div class="score-schools"><h4 style="font-size:14px;color:var(--text-secondary);margin-bottom:10px;">🏫 院校推荐（三档）</h4><div id="schoolSuggestion"></div></div>
            </div>
        </div>
    </div>
    <div class="tab-panel" id="tab-list">
        <div class="filter-bar">
            <input type="text" class="search-box" id="searchInput" placeholder="搜索高校名称、城市..." oninput="filterUniversities()">
            <button class="filter-btn active" data-filter="all" onclick="setFilter('all',this)">全部</button>
            <button class="filter-btn" data-filter="本科" onclick="setFilter('本科',this)">本科</button>
            <button class="filter-btn" data-filter="专科" onclick="setFilter('专科',this)">专科</button>
            <button class="filter-btn" data-filter="zsb" onclick="setFilter('zsb',this)">可专升本</button>
            <select class="filter-select" id="cityFilter" onchange="filterUniversities()"><option value="all">全部城市</option></select>
            <select class="filter-select" id="natureFilter" onchange="filterUniversities()"><option value="all">全部性质</option><option value="公办">公办</option><option value="民办">民办</option></select>
        </div>
        <div class="smart-tags">
            <span class="smart-tag" data-tag="public" onclick="toggleSmartTag(this)">🏛️ 公办优先</span>
            <span class="smart-tag" data-tag="private" onclick="toggleSmartTag(this)">🏷️ 民办本科</span>
            <span class="smart-tag" data-tag="top30" onclick="toggleSmartTag(this)">🏆 排名前30</span>
            <span class="smart-tag" data-tag="capital" onclick="toggleSmartTag(this)">🏙️ 贵阳高校</span>
            <span class="smart-tag" data-tag="zsbhigh" onclick="toggleSmartTag(this)">🚀 热门专升本</span>
        </div>
        <div class="table-wrap">
            <table><thead><tr><th style="width:36px"><input type="checkbox" class="cb-check" id="checkAll" onchange="toggleCheckAll(this)"></th><th>排名</th><th>院校名称</th><th>类型</th><th>性质</th><th>城市</th><th>层次</th><th>可专升本</th></tr></thead><tbody id="uniTbody"></tbody></table>
            <div class="page-info"><span id="tableInfo">加载中...</span><div class="pagination" id="pagination"></div></div>
        </div>
    </div>
</div>

<!-- COMPARE BAR -->
<div class="compare-bar" id="compareBar">
    <span class="cb-count">已选 <strong id="cbCount">0</strong> 所（最多4所）</span>
    <div class="cb-names" id="cbNames"></div>
    <button class="cb-btn cb-btn-clear" onclick="clearCompare()">清空</button>
    <button class="cb-btn cb-btn-primary" id="cbCompareBtn" onclick="openCompareModal()" disabled>开始对比</button>
</div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay" onclick="if(event.target===this)closeModal()">
    <div class="modal" id="modalContent"></div>
</div>

<script>
const API = 'http://localhost:8080';
let allUniversities = [];
let allMapData = [];
let currentFilter = 'all';
let currentPage = 1;
const PAGE_SIZE = 20;
let mapChart = null;
let currentMapLayer = 'all';

async function fetchJSON(url) {
    const res = await fetch(API + url);
    const data = await res.json();
    return data.data;
}

// ========== 倒计时 ==========
function updateCountdowns() {
    const examDate = new Date('2027-04-12T09:00:00+08:00');
    const diff = examDate - new Date();
    if (diff <= 0) { document.getElementById('headerDays').textContent = '0'; return; }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById('headerDays').textContent = d;
    document.getElementById('zDays').textContent = String(d).padStart(3, '0');
    document.getElementById('zHours').textContent = String(h).padStart(2, '0');
    document.getElementById('zMins').textContent = String(m).padStart(2, '0');
    document.getElementById('zSecs').textContent = String(s).padStart(2, '0');
}

// ========== 每日名言 ==========
function initDailyQuote() {
    const quotes = [
        { text: '人生没有白走的路，每一步都算数。', author: '李宗盛' },
        { text: '努力不一定成功，但放弃一定失败。', author: '谚语' },
        { text: '所有的努力都不会白费，你付出多少时间和精力，都是在对未来的积累。', author: '人民日报' },
        { text: '当你觉得坚持不下去的时候，其实你已经离成功很近了。', author: '马云' },
        { text: '不要让未来的你，讨厌现在的自己。', author: '网络' },
        { text: '你现在的付出，都会是一种沉淀，它们会默默铺路，只为让你成为更好的人。', author: '网络' },
        { text: '种一棵树最好的时间是十年前，其次是现在。', author: '非洲谚语' },
        { text: '每一个优秀的人，都有一段沉默的时光。', author: '网络' },
        { text: '把平凡的事做好就是不平凡，把简单的事做好就是不简单。', author: '张瑞敏' },
        { text: '成功的秘诀在于每天都比别人多努力一点。', author: '谚语' },
        { text: '你若不勇敢，没人替你坚强。', author: '网络' },
        { text: '没有伞的孩子，必须努力奔跑。', author: '网络' },
        { text: '生活不会因为你是女生就善待你。', author: '网络' },
        { text: '你必须非常努力，才能看起来毫不费力。', author: '网络' },
        { text: '今天不走，明天要跑。', author: '哈佛校训' },
        { text: '只要路是对的，就不怕路远。', author: '谚语' },
        { text: '含泪播种的人一定能含笑收获。', author: '谚语' },
        { text: '没有天生的信心，只有不断培养的信心。', author: '谚语' },
        { text: '专升本不是终点，而是新的起点。', author: '网络' },
        { text: '你的坚持终将美好。', author: '网络' },
        { text: '越努力，越幸运。', author: '谚语' },
        { text: '星光不负赶路人，时光不负有心人。', author: '网络' },
        { text: '乾坤未定，你我皆是黑马。', author: '网络' },
        { text: '哪有什么一夜成名，其实都是百炼成钢。', author: '易烊千玺' },
        { text: '愿你以渺小启程，以伟大结束。', author: '网络' },
        { text: '看似不起眼的日复一日，会在将来的某一天，突然让你看到坚持的意义。', author: '网络' },
        { text: '少年的肩应该担起草长莺飞和明月清风。', author: '网络' },
        { text: '你只管努力，剩下的交给时间。', author: '网络' },
        { text: '你的名字那么好听，一定要出现在录取通知书上。', author: '网络' },
        { text: '既然选择了远方，便只顾风雨兼程。', author: '汪国真' },
    ];
    const today = new Date();
    const dayOfYear = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / 86400000);
    const q = quotes[dayOfYear % quotes.length];
    const el = document.getElementById('dailyQuote');
    if (el) {
        el.innerHTML = '<div class="dq-text">"' + q.text + '"</div><div class="dq-author">— ' + q.author + '</div>';
    }
}

// ========== Tab 切换 ==========
function switchTab(name) {
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === 'tab-' + name));
    if (name === 'map' && mapChart) setTimeout(() => mapChart.resize(), 100);
}
document.querySelectorAll('.nav-tab').forEach(tab => tab.addEventListener('click', () => switchTab(tab.dataset.tab)));

